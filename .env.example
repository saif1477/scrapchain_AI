# --- Database ---
# Production: PostgreSQL 16 + TimescaleDB. Falls back to SQLite if unset (demo mode).
DATABASE_URL=postgresql://scrapchain_user:scrapchain_pass@localhost:5432/scrapchain

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- Hyperledger Fabric ---
FABRIC_MSP_ID=ScrapChainMSP
FABRIC_PEER_ENDPOINT=peer0.scrapchain.org:7051
FABRIC_CHANNEL=scrapchain-channel
FABRIC_CHAINCODE=receipt-chaincode
# Demo mode: set to "simulated" to use the built-in hash-chained ledger
FABRIC_MODE=simulated

# --- AWS (edge sync / S3 model distribution) ---
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_REGION=ap-south-1
S3_MODEL_BUCKET=scrapchain-tflite-models

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
